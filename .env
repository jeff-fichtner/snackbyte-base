# Local development environment. Committed: it documents every variable the app reads locally.
# Every value here is plain local config, declared on the config line below; a secret never
# appears here as a value.
#
# To add a secret: create the 1Password item snackbyte-base.local in the vault app-secrets, with
# one field named after the variable, then add its reference here:
#   KEY=op://app-secrets/snackbyte-base.local/KEY
# From then on, run the dev server under op run:
#   op run --env-file=.env -- npm run dev
# Without op run, the dev and build scripts stop at startup and name the unresolved variable
# (scripts/load-env.mjs). A raw value for a key that is not on the config line below fails the
# check gate (npm run check:env).
# config: PORT
#
# Production never reads this file: Cloud Run injects PORT and holds the rest of the service's
# configuration.
#
# Variable expansion is supported, e.g.:
#   HOST=localhost
#   BASE_URL=http://${HOST}:${PORT}

# Port the server listens on (and the dev proxy targets).
PORT=8080
