{
  "name": "snackbyte-base",
  "version": "1.5",
  "private": true,
  "type": "module",
  "description": "The hub that composes a snackbyte app from standalone templates: a web front end, a server, a deploy target.",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "init": "node hub/init.mjs",
    "setup": "node hub/templates.mjs setup",
    "spec:html": "spec-render",
    "spec:html:watch": "spec-render --watch",
    "lint": "eslint .",
    "format": "prettier --config config/.prettierrc.json --ignore-path config/.prettierignore --write \"**/*.{ts,js,mjs,json,md}\"",
    "format:check": "prettier --config config/.prettierrc.json --ignore-path config/.prettierignore --check \"**/*.{ts,js,mjs,json,md}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:env": "node hub/files/scripts/check-env-files.mjs",
    "check:hub": "npm run format:check && npm run lint && npm run typecheck && npm run check:env && npm test",
    "check:templates": "node hub/templates.mjs check",
    "check:all": "npm run check:hub && npm run check:templates",
    "e2e:image": "node hub/image-e2e.mjs",
    "check:standalone": "node hub/standalone-check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@snackbyte/spec-render": "^0.1.0",
    "@types/node": "^25.9.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.11"
  }
}
