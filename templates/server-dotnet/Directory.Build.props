<Project>

  <!--
    The .NET release is one setting: the SDK version in global.json. Its major.minor (11.0 for
    11.0.100) is the release. The target framework and the test host's version follow from it here;
    see the README, "The .NET release".
  -->
  <PropertyGroup>
    <DotnetRelease>$([System.Text.RegularExpressions.Regex]::Replace($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)global.json')), '(?s)^.*?"version"\s*:\s*"(\d+\.\d+)\.[^"]*".*$', '$1'))</DotnetRelease>
  </PropertyGroup>

  <!-- Settings every project in this solution shares. -->
  <PropertyGroup>
    <TargetFramework>net$(DotnetRelease)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!--
    The environments manifest. Standalone, this folder holds its own environments.json; inside an
    app, the app's one copy sits in the parent folder. Exactly those two places are looked in, in
    that order. Api.csproj stops the build when neither has it.
  -->
  <PropertyGroup>
    <ManifestHome>$(MSBuildThisFileDirectory)</ManifestHome>
    <EnvironmentsManifest Condition="Exists('$(ManifestHome)environments.json')">$(ManifestHome)environments.json</EnvironmentsManifest>
    <EnvironmentsManifest Condition="'$(EnvironmentsManifest)' == '' and Exists('$(ManifestHome)../environments.json')">$([System.IO.Path]::GetFullPath('$(ManifestHome)../environments.json'))</EnvironmentsManifest>
  </PropertyGroup>

  <!-- A global.json without an SDK version leaves no release to target: stop, naming the setting. -->
  <Target Name="CheckDotnetRelease" BeforeTargets="_GenerateRestoreProjectPathWalk;_CheckForInvalidConfigurationAndPlatform">
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(DotnetRelease)', '^\d+\.\d+$'))" Text="global.json names no SDK version (sdk.version, e.g. 11.0.100); the .NET release is read from it." />
  </Target>

</Project>
